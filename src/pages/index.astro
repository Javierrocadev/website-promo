---
import BrowserFrame from '../components/BrowserFrame.astro';
import Controls from '../components/Controls.astro';
import RecordingStage from '../components/RecordingStage.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="Convierte una web real en una escena promocional animada y lista para grabar."
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Website Promo — Crea una escena para tu web</title>
	</head>
	<body>
		<main class="app-shell">
			<header class="hero">
				<div class="hero__eyebrow">
					<span class="hero__mark" aria-hidden="true"></span>
					Website Promo · Studio
				</div>
				<div class="hero__copy">
					<div class="hero__main">
						<h1>Presenta tu web</h1>
						<form class="url-form hero__url-form" data-url-form novalidate>
							<div class="field field--url">
								<label class="visually-hidden" for="website-url">URL de la web</label>
								<div class="url-input-wrap">
									<input
										id="website-url"
										name="website-url"
										type="text"
										inputmode="url"
										autocomplete="url"
										placeholder="https://tuportfolio.com"
										aria-describedby="url-error"
										data-url-input
									/>
								</div>
								<p class="field-error" id="url-error" role="alert" data-url-error></p>
							</div>
							<button class="button button--primary button--load" type="submit">
								Cargar web
								<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
							</button>
						</form>
					</div>
					<p class="hero__description">Construye una escena 16:9, ajusta el mensaje y graba una entrada que se sienta tuya.</p>
				</div>
			</header>

			<Controls />
			<RecordingStage>
				<BrowserFrame />
			</RecordingStage>

			<footer class="site-footer">
				<p>Todo ocurre en tu navegador. No subimos ni guardamos tu web.</p>
				<span>Website Promo · v1</span>
			</footer>
		</main>

		<script>
			import '../scripts/editor';
		</script>
	</body>
</html>
