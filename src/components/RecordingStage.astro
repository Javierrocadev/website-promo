<section class="preview" aria-label="Escena para grabar">
	<div class="fullscreen-stage" data-stage-fullscreen>
	<section class="recording-controls" aria-labelledby="playback-group-title" data-fullscreen-controls>
		<div class="recording-controls__intro">
			<h3 id="playback-group-title">Reproducción</h3>
			<div class="recording-status" aria-live="polite">
				<span aria-hidden="true"></span>
				<strong data-stage-status>Preparando controles</strong>
			</div>
		</div>

		<div class="playback-actions" aria-label="Controles de reproducción">
			<button class="button button--primary" type="button" data-action="play" disabled><span class="button-symbol" aria-hidden="true">▶</span> Reproducir</button>
			<button class="button button--secondary" type="button" data-action="pause" disabled><span class="button-symbol" aria-hidden="true">Ⅱ</span> Pausar</button>
			<button class="icon-button" type="button" aria-label="Reiniciar animación" data-action="restart" disabled>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /></svg>
			</button>
		</div>

		<div class="toggle-list">
			<label class="toggle-row">
				<span><strong>Sin animación</strong><small>Composición fija</small></span>
				<input type="checkbox" data-static-toggle />
				<span class="toggle" aria-hidden="true"></span>
			</label>
			<label class="toggle-row">
				<span><strong>Cuenta atrás</strong><small>Tres segundos</small></span>
				<input type="checkbox" checked data-countdown-toggle />
				<span class="toggle" aria-hidden="true"></span>
			</label>
		</div>

		<div class="playback-footer">
			<button class="text-button" type="button" data-action="fullscreen" disabled>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5" /></svg>
				Pantalla completa
			</button>
			<button class="text-button text-button--muted" type="button" data-action="reset">Restablecer</button>
		</div>
	</section>
	<button class="fullscreen-controls-handle" type="button" aria-label="Mostrar controles de reproducción" data-fullscreen-controls-handle>
		<span aria-hidden="true"></span>
	</button>

	<div class="stage-frame">
		<div class="stage-viewport" data-stage-viewport>
			<div class="stage-canvas" data-stage-canvas style="--stage-background: #121212; --stage-text: #ffffff;">
				<div class="stage-glow" aria-hidden="true"></div>
				<div class="stage-grid" aria-hidden="true"></div>
				<slot />
				<div class="stage-copy" data-stage-copy>
					<span class="stage-copy__label" data-stage-presenting>Presenting</span>
					<h2 data-stage-title>Website<br />Promo</h2>
					<div class="stage-copy__line" aria-hidden="true"></div>
				</div>
				<div class="stage-brand" data-stage-brand>
					<span data-stage-brand-text>Tu marca</span>
					<img data-stage-brand-logo alt="" hidden />
				</div>
				<div class="stage-countdown" data-stage-countdown hidden aria-live="assertive"></div>
			</div>
		</div>
	</div>
	</div>

	<div class="preview-meta">
		<p class="embed-help">
			<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>
			¿No se muestra la web? Puede que esta dirección no permita su incrustación.
		</p>
		<span>Formato 16:9 · Lienzo 1920 × 1080</span>
	</div>
</section>
