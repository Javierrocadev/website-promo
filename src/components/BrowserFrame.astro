<div class="browser-perspective" data-browser-perspective>
	<div class="browser-frame" data-browser-frame>
		<div class="browser-bar" aria-hidden="true">
			<div class="browser-dots"><span></span><span></span><span></span></div>
			<div class="browser-address">
				<svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
				<span data-browser-address>tuportfolio.com</span>
			</div>
			<div class="browser-menu"><span></span><span></span><span></span></div>
		</div>
		<div class="browser-content">
			<div class="browser-empty" data-browser-empty>
				<div class="browser-empty__icon" aria-hidden="true">
					<svg viewBox="0 0 32 32"><rect x="3" y="5" width="26" height="22" rx="3"/><path d="M3 11h26"/><path d="m12 21 3-3 3 3 4-5 4 5"/></svg>
				</div>
				<strong>Tu web aparecerá aquí</strong>
				<span>Introduce una URL para cargarla en la escena.</span>
			</div>
			<iframe title="Vista previa de la web promocionada" referrerpolicy="strict-origin-when-cross-origin" data-browser-iframe hidden></iframe>
		</div>
	</div>
</div>

<div class="mobile-perspective" data-mobile-perspective>
	<div class="mobile-frame">
		<div class="mobile-speaker" aria-hidden="true"></div>
		<div class="mobile-screen">
			<div class="mobile-status" aria-hidden="true">
				<span>9:41</span>
				<div><i></i><i></i><i></i></div>
			</div>
			<div class="mobile-content">
				<div class="mobile-empty" data-browser-empty>
					<div class="mobile-empty__icon" aria-hidden="true">
						<svg viewBox="0 0 32 32"><rect x="8" y="3" width="16" height="26" rx="3"/><path d="M13 7h6M14 25h4"/></svg>
					</div>
					<strong>Vista móvil</strong>
					<span>Tu web también aparecerá aquí</span>
				</div>
				<iframe title="Vista previa móvil de la web promocionada" referrerpolicy="strict-origin-when-cross-origin" data-browser-iframe hidden></iframe>
			</div>
		</div>
		<div class="mobile-home" aria-hidden="true"></div>
	</div>
</div>
