<section class="controls" aria-label="Configuración de la pieza">
	<div class="editor-panel">
		<div class="editor-grid">
			<section class="design-panel" aria-label="Diseño">
				<details class="design-disclosure">
					<summary>
						<span>
							<strong>Personalizar diseño</strong>
							<small>Pantalla, color, texto y firma</small>
						</span>
					</summary>
					<div class="design-grid">
					<div class="design-section design-section--device">
						<h4>Pantalla</h4>
						<div class="segmented-control" role="group" aria-label="Tipo de pantalla">
							<button type="button" aria-pressed="true" data-device-mode="desktop">Escritorio</button>
							<button type="button" aria-pressed="false" data-device-mode="mobile">Móvil</button>
						</div>
					</div>
					<div class="design-section design-section--colors">
						<h4>Color</h4>
						<div class="color-presets" role="group" aria-label="Combinaciones de color">
							<button class="color-preset" type="button" aria-label="Fondo negro y texto blanco" title="Negro y blanco" data-color-background="#121212" data-color-text="#FFFFFF">
								<span style="--preset-background: #121212; --preset-text: #FFFFFF" aria-hidden="true"></span>
							</button>
							<button class="color-preset" type="button" aria-label="Fondo rojo y texto marfil" title="Rojo y marfil" data-color-background="#B91C1C" data-color-text="#FFF7ED">
								<span style="--preset-background: #B91C1C; --preset-text: #FFF7ED" aria-hidden="true"></span>
							</button>
							<button class="color-preset" type="button" aria-label="Fondo azul y texto blanco azulado" title="Azul y blanco" data-color-background="#1D4ED8" data-color-text="#EFF6FF">
								<span style="--preset-background: #1D4ED8; --preset-text: #EFF6FF" aria-hidden="true"></span>
							</button>
							<button class="color-preset" type="button" aria-label="Fondo amarillo y texto negro" title="Amarillo y negro" data-color-background="#FACC15" data-color-text="#111827">
								<span style="--preset-background: #FACC15; --preset-text: #111827" aria-hidden="true"></span>
							</button>
							<button class="color-preset" type="button" aria-label="Fondo morado y texto blanco" title="Morado y blanco" data-color-background="#6D28D9" data-color-text="#FAF5FF">
								<span style="--preset-background: #6D28D9; --preset-text: #FAF5FF" aria-hidden="true"></span>
							</button>
						</div>
						<div class="color-fields">
							<div class="field">
								<label for="background-color">Fondo</label>
								<div class="color-control">
									<input id="background-color" type="color" value="#121212" data-background-picker />
									<input aria-label="Color hexadecimal del fondo" type="text" value="#121212" maxlength="7" spellcheck="false" data-background-hex />
								</div>
							</div>
							<div class="field">
								<label for="text-color">Texto</label>
								<div class="color-control">
									<input id="text-color" type="color" value="#ffffff" data-text-picker />
									<input aria-label="Color hexadecimal del texto" type="text" value="#FFFFFF" maxlength="7" spellcheck="false" data-text-hex />
								</div>
							</div>
						</div>
					</div>

					<div class="design-section design-section--content">
						<h4>Texto</h4>
						<div class="content-fields">
							<div class="field">
								<label for="promo-presenting">Texto superior</label>
								<input id="promo-presenting" type="text" value="Presenting" maxlength="28" data-presenting-input />
							</div>
							<div class="field">
								<label for="promo-title">Título</label>
								<textarea id="promo-title" rows="2" maxlength="48" data-title-input>Website
Promo</textarea>
								<span class="field-counter"><span data-title-count>13</span>/48</span>
							</div>
						</div>
					</div>

					<div class="design-section design-section--brand">
						<h4>Firma</h4>
						<fieldset class="brand-editor">
							<legend class="visually-hidden">Marca opcional</legend>
							<div class="segmented-control" role="group" aria-label="Tipo de marca">
								<button type="button" aria-pressed="true" data-brand-mode="text">Texto</button>
								<button type="button" aria-pressed="false" data-brand-mode="logo">Logo</button>
							</div>

							<div class="brand-panel" data-brand-text-panel>
								<label class="visually-hidden" for="promo-brand">Nombre de la marca</label>
								<input id="promo-brand" type="text" value="Tu marca" maxlength="32" data-brand-input />
							</div>

							<div class="brand-panel brand-panel--logo" data-brand-logo-panel hidden>
								<input
									class="visually-hidden"
									id="brand-logo-file"
									type="file"
									accept="image/png,image/jpeg,image/webp,image/svg+xml"
									aria-describedby="logo-hint logo-error"
									data-logo-input
								/>
								<label class="logo-upload" for="brand-logo-file">
									<span class="logo-upload__preview" aria-hidden="true">
										<img data-logo-preview alt="" hidden />
										<svg data-logo-placeholder viewBox="0 0 24 24"><path d="M12 16V4M7 9l5-5 5 5" /><path d="M5 13v6h14v-6" /></svg>
									</span>
									<span class="logo-upload__copy">
										<strong data-logo-name>Seleccionar logo</strong>
										<small id="logo-hint">PNG, JPG, WebP o SVG · máximo 1 MB</small>
									</span>
								</label>
								<div class="logo-actions">
									<p class="field-error" id="logo-error" role="alert" data-logo-error></p>
									<button class="text-button text-button--muted" type="button" data-logo-remove hidden>Quitar logo</button>
								</div>
							</div>
						</fieldset>
					</div>
					</div>
				</details>
			</section>

		</div>
	</div>
</section>
